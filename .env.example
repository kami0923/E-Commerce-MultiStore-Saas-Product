DATABASE_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/postgres?sslmode=require"
# Recommended for Vercel runtime traffic. Leave blank locally if your provider
# supplies only one PostgreSQL connection string.
DATABASE_URL_POOLED="postgresql://USER:PASSWORD@POOLED_HOST:5432/postgres?sslmode=require"
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Optional extra origin for a LAN/device preview, e.g. http://192.168.1.2:3005
AUTH_TRUSTED_ORIGIN=""

# Durable production media. Cloudflare R2 is preferred; Vercel Blob remains a
# supported fallback. Keep every credential server-only (never NEXT_PUBLIC_*).
MEDIA_STORAGE_PROVIDER="r2"
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="meridian-commerce-media"
# Use the bucket's custom public domain in production, without a trailing slash.
R2_PUBLIC_BASE_URL="https://media.example.com"

# Optional fallback: created automatically after connecting Vercel Blob.
BLOB_READ_WRITE_TOKEN=""

# Production notifications (keep real values in hosting secrets only)
CRON_SECRET="replace-with-a-long-random-secret"
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Meridian Commerce <orders@example.com>"
# Meta app settings for merchant WhatsApp Embedded Signup
META_APP_ID=""
META_APP_SECRET=""
META_WHATSAPP_CONFIG_ID=""
NEXT_PUBLIC_META_APP_ID=""
NEXT_PUBLIC_META_WHATSAPP_CONFIG_ID=""
# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=""
WHATSAPP_GRAPH_VERSION="v22.0"

# Optional platform fallback sender. Merchant-linked store accounts take priority.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# Merchant payment adapters (onboarding credentials required)
PAYFAST_MERCHANT_ID=""
PAYFAST_SECURED_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

