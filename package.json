{
  "name": "meridian-commerce",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:bootstrap": "prisma migrate deploy",
    "db:generate:sqlite": "prisma generate --schema prisma/schema.sqlite.prisma",
    "db:activate:postgres": "node scripts/activate-postgres.mjs",
    "db:migrate:sqlite-to-postgres": "node --experimental-strip-types scripts/migrate-sqlite-to-postgres.mjs",
    "db:verify:postgres": "node --experimental-strip-types scripts/verify-postgres-migration.mjs",
    "db:migrate:media": "node scripts/migrate-product-media.mjs",
    "db:migrate:team": "node scripts/migrate-team-invitations.mjs",
    "db:migrate:commerce-setup": "node scripts/migrate-commerce-setup.mjs",
    "db:migrate:customer-care": "node scripts/migrate-customer-care.mjs",
    "db:migrate:whatsapp": "node scripts/migrate-whatsapp-linking.mjs",
    "db:backup": "node scripts/backup-sqlite.mjs",
    "admin:reset-password": "node scripts/reset-super-admin-password.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.7.14",
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.2.0",
    "@vercel/blob": "^2.4.0",
    "better-auth": "^1.7.14",
    "clsx": "^2.1.1",
    "lucide-react": "^0.548.0",
    "next": "^16.0.0",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.17",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "es-abstract": "^1.24.2",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.0.0",
    "postcss": "^8.5.6",
    "prisma": "^7.2.0",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3"
  }
}
